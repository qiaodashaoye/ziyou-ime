<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      allowBackup=false：输入法的用户词典（rime_user/）会随使用积累已输入词汇，属敏感数据。
      关闭自动备份 / adb backup 提取，避免用户输入痕迹经云备份或本地备份外泄（隐私优先）。
    -->
    <application
        android:name=".ZiyouApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:theme="@style/Theme.Ziyou">

        <!-- 输入法服务声明 -->
        <service
            android:name=".ime.ZiYouInputMethodService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/input_method" />
        </service>

        <!-- 设置页面 -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 扩展词库管理 -->
        <activity
            android:name=".ui.DictManagerActivity"
            android:exported="false"
            android:label="扩展词库" />

        <!-- 技能插件管理 -->
        <activity
            android:name=".ui.SkillManagerActivity"
            android:exported="false"
            android:label="技能插件" />

        <!-- 技能开发文档 -->
        <activity
            android:name=".ui.SkillDevGuideActivity"
            android:exported="false"
            android:label="技能开发文档" />

        <!-- 等级体系详情 -->
        <activity
            android:name=".ui.LevelActivity"
            android:exported="false"
            android:label="我的等级" />

    </application>
</manifest>
