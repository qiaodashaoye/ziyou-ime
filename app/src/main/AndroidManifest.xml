<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      allowBackup=false：输入法的用户词典（rime_user/）会随使用积累已输入词汇，属敏感数据。
      关闭自动备份 / adb backup 提取，避免用户输入痕迹经云备份或本地备份外泄（隐私优先）。
    -->
    <application
        android:name=".ZiyouApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:theme="@style/Theme.Ziyou">

        <!-- 输入法服务声明 -->
        <service
            android:name=".ime.ZiYouInputMethodService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/input_method" />
        </service>

        <!-- 设置页面 -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 扩展词库管理 -->
        <activity
            android:name=".ui.DictManagerActivity"
            android:exported="false"
            android:label="扩展词库" />

        <!-- 技能插件管理 -->
        <activity
            android:name=".ui.SkillManagerActivity"
            android:exported="false"
            android:label="技能插件" />

        <!-- 技能开发文档 -->
        <activity
            android:name=".ui.SkillDevGuideActivity"
            android:exported="false"
            android:label="技能开发文档" />

        <!-- 等级体系详情 -->
        <activity
            android:name=".ui.LevelActivity"
            android:exported="false"
            android:label="我的等级" />

        <!--
          图片选择中转 Activity（发送图片功能）：输入法进程无 Activity，
          借此透明跳板拉起系统图片选择器；透明、不进最近任务、无历史，选完即销毁。
        -->
        <activity
            android:name=".ime.ImagePickerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!--
          FileProvider：把 cache/ime_images/ 下的待发送图片暴露为 content:// URI，
          经 commitContent(INPUT_CONTENT_GRANT_READ_URI_PERMISSION) 临时授权给目标应用读取。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.imecontent"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/ime_file_paths" />
        </provider>

    </application>
</manifest>
