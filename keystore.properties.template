# 字由输入法发布签名配置模板
# 使用方法：
#   1. 复制本文件为 keystore.properties（已被 .gitignore 忽略，禁止提交）
#   2. 若尚无密钥库，先生成（有效期 ~27 年，妥善备份，丢失将无法覆盖升级）：
#      keytool -genkeypair -v -keystore release.keystore -alias ziyou \
#        -keyalg RSA -keysize 4096 -validity 10000
#   3. 填入实际路径与口令（storeFile 为相对仓库根目录的路径或绝对路径）
storeFile=release.keystore
storePassword=CHANGE_ME
keyAlias=ziyou
keyPassword=CHANGE_ME
